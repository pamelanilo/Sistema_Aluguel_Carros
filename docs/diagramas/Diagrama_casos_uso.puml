@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam DefaultFontName Arial

title Sistema de Aluguel de Carros - Diagrama de Casos de Uso

actor Cliente
actor Agente <<abstract>>
actor "Agente da Empresa" as AgenteEmpresa
actor "Agente do Banco" as AgenteBanco

AgenteEmpresa --|> Agente
AgenteBanco --|> Agente

rectangle "Sistema de Aluguel de Carros" {

    usecase "Cadastrar-se" as UC0
    usecase "Autenticar-se" as UC1

    usecase "Cadastrar dados\ndo cliente" as UC2
    usecase "Consultar dados\ndo cliente" as UC3
    usecase "Modificar dados\ndo cliente" as UC4
    usecase "Excluir cadastro\ndo cliente" as UC5

    usecase "Introduzir pedido\nde aluguel" as UC6
    usecase "Modificar pedido\nde aluguel" as UC7
    usecase "Consultar pedido\nde aluguel" as UC8
    usecase "Cancelar pedido\nde aluguel" as UC9

    usecase "Avaliar pedido\nde aluguel" as UC10

    usecase "Registrar automóvel" as UC11
    usecase "Registrar propriedade\ndo automóvel" as UC12
    usecase "Registrar contrato\nde crédito" as UC13
}

Cliente --> UC0
Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Cliente --> UC7
Cliente --> UC8
Cliente --> UC9

Agente --> UC0
Agente --> UC1
Agente --> UC7
Agente --> UC8
Agente --> UC10
Agente --> UC11
Agente --> UC12

AgenteBanco --> UC13

@enduml
