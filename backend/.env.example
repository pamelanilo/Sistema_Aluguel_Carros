# Copie para .env (ou exporte no terminal). NUNCA versione credenciais reais.
# Supabase > Connect > Session pooler (porta 5432) ou Direct connection
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO
# Token exigido (header X-Setup-Token) para criar o primeiro agente. Gere um valor longo e aleatório.
APP_SETUP_TOKEN=TROQUE_POR_UM_TOKEN_ALEATORIO
# Origens permitidas no CORS (separadas por vírgula)
APP_CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
