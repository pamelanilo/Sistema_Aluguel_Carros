@startuml
!pragma layout smetana
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #DAE8FC
  BorderColor #6C8EBF
  BackgroundColor<<abstract>> #E1D5E7
  BorderColor<<abstract>> #9673A6
  BackgroundColor<<enumeration>> #FFF2CC
  BorderColor<<enumeration>> #D6B656
}
title VRUM! - Diagrama de Classes: pacote model (entidades JPA) - v2

abstract class Usuario <<abstract>> {
  - id : Long
  - login : String
  - senha : String
  - nome : String
}
class Cliente {
  - rg : String
  - cpf : String
  - endereco : String
  - profissao : String
  --
  + adicionarRendimento(r : Rendimento)
}
class Rendimento {
  - id : Long
  - entidadeEmpregadora : String
  - valor : BigDecimal
}
abstract class Agente <<abstract>> {
  - cnpj : String
}
class AgenteEmpresa {
  - razaoSocial : String
}
class AgenteBanco {
  - codigoBanco : String
}
class Automovel {
  - id : Long
  - matricula : String
  - ano : int
  - marca : String
  - modelo : String
  - placa : String
}
class Pedido {
  - id : Long
  - dataCriacao : LocalDate
  - dataInicio : LocalDate
  - dataFim : LocalDate
  - valorTotal : BigDecimal
  - status : StatusPedido
  - parecerFinanceiro : String
}
class ContratoAluguel {
  - id : Long
  - dataAssinatura : LocalDate
  - tipo : TipoContrato
  - status : StatusContrato
}
class ContratoCredito {
  - id : Long
  - valorConcedido : BigDecimal
  - taxaJuros : BigDecimal
  - parcelas : int
}
enum StatusPedido <<enumeration>> {
  PENDENTE
  EM_ANALISE
  APROVADO
  REPROVADO
  CANCELADO
}
enum StatusContrato <<enumeration>> {
  ASSINADO
  EXECUTADO
}
enum TipoContrato <<enumeration>> {
  PROPRIEDADE_CLIENTE
  PROPRIEDADE_EMPRESA
  PROPRIEDADE_BANCO
}

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- AgenteEmpresa
Agente <|-- AgenteBanco
Cliente "1" *-- "0..3" Rendimento : possui
Cliente "1" -- "0..*" Pedido : solicita
Agente "0..1" -- "0..*" Pedido : analisa/avalia
Pedido "0..*" -- "1" Automovel : seleciona
Pedido "1" -- "0..1" ContratoAluguel : origina
Usuario "1" -- "0..*" Automovel : proprietário
ContratoAluguel "1" -- "0..1" ContratoCredito : pode possuir
AgenteBanco "1" -- "0..*" ContratoCredito : concede
Pedido --> StatusPedido
ContratoAluguel --> TipoContrato
ContratoAluguel --> StatusContrato

note right of Rendimento
  Regra: no máximo três rendimentos
  por cliente.
end note
note bottom of Automovel
  O proprietário é um Usuario (Cliente,
  AgenteEmpresa ou AgenteBanco) e é
  atualizado ao gerar o contrato de aluguel.
end note
note bottom of Pedido
  PENDENTE -> EM_ANALISE -> APROVADO | REPROVADO
  Cancelamento: PENDENTE ou EM_ANALISE.
  Aprovação exige o automóvel livre no período
  (sem outro pedido APROVADO sobreposto).
end note

legend right
  <b>Legenda</b>
  Triângulo vazado: herança (JOINED)
  Losango cheio: composição
  Seta aberta: associação navegável / uso de enum
  Linha simples: associação bidirecional
  Getters e setters omitidos.
endlegend
@enduml
