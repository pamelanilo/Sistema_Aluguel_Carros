# Copie para backend/.env (lido automaticamente pelo Spring). NUNCA versione credenciais reais.
# Supabase > Connect > Transaction pooler (porta 6543): aceita muitas conexões simultâneas.
# "prepareThreshold=0" é obrigatório no Transaction pooler com o driver JDBC.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO
# Token (header X-Setup-Token) para criar agentes via API quando o autocadastro estiver desligado.
APP_SETUP_TOKEN=TROQUE_POR_UM_TOKEN_ALEATORIO
# true = a tela de cadastro permite criar contas de Empresa e Banco; false = só clientes (agentes via token)
APP_CADASTRO_AGENTES_PUBLICO=true
# Origens permitidas no CORS (separadas por vírgula)
APP_CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
