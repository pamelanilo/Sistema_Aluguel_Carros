@startuml
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam DefaultFontName Arial

actor Cliente
actor Agente <<abstract>>
actor "Agente da Empresa" as AgenteEmpresa
actor "Agente do Banco" as AgenteBanco
AgenteEmpresa --|> Agente
AgenteBanco --|> Agente

rectangle "VRUM! - Sistema de Aluguel de Carros (Casos de Uso - v2)" {
  usecase "Cadastrar cliente" as UC_Cad
  usecase "Cadastrar-se como empresa / banco\n(CNPJ; pode ser restrito por configuração)" as UC_CadAgente
  usecase "Consultar / alterar meus dados\n(até 3 rendimentos)" as UC_MeusDados
  usecase "Autenticar-se" as UC_Login
  usecase "Consultar automóveis" as UC_Carros
  usecase "Registrar automóvel" as UC_RegCarro
  usecase "Alterar / excluir automóvel" as UC_ManCarro
  usecase "Introduzir pedido" as UC_Criar
  usecase "Consultar pedidos e status" as UC_Consultar
  usecase "Modificar pedido" as UC_Mod
  usecase "Cancelar pedido" as UC_Cancelar
  usecase "Consultar pedidos recebidos" as UC_ListaAgente
  usecase "Modificar pedido em análise" as UC_ModAgente
  usecase "Iniciar análise financeira" as UC_Analisar
  usecase "Consultar renda do cliente" as UC_Renda
  usecase "Aprovar / recusar pedido (com justificativa)" as UC_Avaliar
  usecase "Consultar dados de cliente" as UC_Cliente
  usecase "Cadastrar / modificar / excluir cliente" as UC_CRUD
  usecase "Gerar contrato de aluguel" as UC_Contrato
  usecase "Registrar contrato de crédito" as UC_Credito
  usecase "Consultar contratos\n(cliente: somente os seus)" as UC_ConsultarContrato
}

Cliente --> UC_Cad
Cliente --> UC_MeusDados
Cliente --> UC_Login
Cliente --> UC_Carros
Cliente --> UC_Criar
Cliente --> UC_Consultar
Cliente --> UC_Mod
Cliente --> UC_Cancelar
Cliente --> UC_ConsultarContrato

Agente --> UC_Login
Agente --> UC_ListaAgente
Agente --> UC_ModAgente
Agente --> UC_Analisar
Agente --> UC_Renda
UC_Analisar ..> UC_Renda : <<include>>
Agente --> UC_Avaliar
Agente --> UC_Cliente
Agente --> UC_CRUD
Agente --> UC_RegCarro
Agente --> UC_ManCarro
Agente --> UC_Contrato
Agente --> UC_ConsultarContrato
AgenteBanco --> UC_Credito
Agente --> UC_CadAgente

@enduml
